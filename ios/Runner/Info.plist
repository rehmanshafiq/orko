<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>HUBCO Green</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>HUBCO Green</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>GMSApiKey</key>
		<string>$(MAPS_API_KEY)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<!-- Enables the live-charging Live Activity (ActivityKit, iOS 16.1+). -->
		<key>NSSupportsLiveActivities</key>
		<true/>
		<key>UIBackgroundModes</key>
		<array>
			<string>fetch</string>
			<string>remote-notification</string>
		</array>
		<!-- UIScene lifecycle (required for CarPlay). The phone UI loads the Main
		     storyboard from its scene config (UISceneStoryboardFile);
		     PhoneSceneDelegate subclasses FlutterSceneDelegate. -->
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<!-- CarPlay (charging category; requires the
				     com.apple.developer.carplay-charging entitlement). -->
				<key>CPTemplateApplicationSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>CPTemplateApplicationScene</string>
						<key>UISceneConfigurationName</key>
						<string>CarPlay</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
					</dict>
				</array>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>Phone</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).PhoneSceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Your location is used to center the map on you and show nearby stations.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>Your location is used to center the map on you and show nearby stations, including in the background.</string>
		<key>NSCameraUsageDescription</key>
		<string>Camera access is needed to scan QR codes and take your profile photo.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Photo library access is needed to choose a profile photo.</string>
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>comgooglemaps</string>
		</array>
        <key>CFBundleURLTypes</key>
        <array>
            <dict>
                <key>CFBundleTypeRole</key>
                <string>Editor</string>

                <key>CFBundleURLSchemes</key>
                <array>
                    <string>com.googleusercontent.apps.60291270702-vu5pgjgmbvoj4bv00dldbioj0isreeuk</string>
                </array>
            </dict>
        </array>
        <key>FirebaseAppDelegateProxyEnabled</key>
        <true/>
        <key>GIDClientID</key>
        <string>60291270702-vu5pgjgmbvoj4bv00dldbioj0isreeuk.apps.googleusercontent.com</string>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
