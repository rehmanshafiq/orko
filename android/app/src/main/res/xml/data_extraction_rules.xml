<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- get_storage writes to getApplicationDocumentsDirectory (app_flutter),
         which lives at the app-data root — NOT under the "file" (files/) domain. -->
    <cloud-backup>
        <exclude domain="root" path="app_flutter/GetStorage.gs" />
        <exclude domain="root" path="app_flutter/GetStorage.bak" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/GetStorage.gs" />
        <exclude domain="root" path="app_flutter/GetStorage.bak" />
    </device-transfer>
</data-extraction-rules>
